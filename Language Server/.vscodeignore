.vscode/**
.gitignore
.vsixmanifest
.testBin/**

# Source files - webpack bundles these into client/out and server/out
client/src/**
server/src/**

# Node modules - not needed since webpack bundles all dependencies
**/node_modules/**

# Build/config artifacts
**/*.js.map
**/*.LICENSE.txt
**/*.ts
**/*.tsbuildinfo
**/tsconfig.json
**/webpack.config.js
**/tslint.json
**/package-lock.json
client/package.json
server/package.json
*.cmd

# Test fixtures
**/_test/**

# Docs (except user-facing ones)
CHANGELOG.md
roadmap.md
todo.md
info.md
Poll.md